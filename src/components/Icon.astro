	| 'arrow-up'
	| 'arrow-left'
	| 'close'
	| 'star'
	| 'shield'
	| 'person'
	| 'coin'
	| 'leaf'
	| 'instagram'
	| 'linkedin'
	| 'pinterest';

interface Props {
	name: Name;
	class?: string;
}

