---
/*
 * Cinematic footer — Astro port of the "motion-footer" React component.
 *
 * The outer wrapper sits in normal flow with a clip-path, while the <footer> inside is
 * position: fixed to the bottom of the viewport. Scrolling the page therefore pulls the
 * content above away like a curtain, revealing the footer underneath. Its contents reveal
 * once, together, when the wrapper becomes visible ([data-reveal-scope], see reveal.ts).
 */
import Icon from './Icon.astro';
import { nav, services, studio } from '../data/site';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const href = (h: string) => (isHome ? h : `/${h}`);
const year = new Date().getFullYear();
const socialIcon = (label: string) => label.toLowerCase() as 'instagram' | 'linkedin' | 'pinterest';

const marquee = [...services.map((s) => s.title), 'Lisbon since 2009', 'One partner, start to finish'];
const sitemap = nav.filter((n) => n.href !== '#contact');
---

<div class="cine-wrap" data-cine data-reveal-scope>
	<footer class="cine">
		<div class="cine__aurora" aria-hidden="true"></div>
		<div class="cine__grid" aria-hidden="true"></div>

		<div class="cine__giant" aria-hidden="true" data-reveal="giant">Minor Mass</div>

		<div class="cine__marquee" aria-hidden="true">
			<div class="cine__marquee-track" data-reveal="slide">
				{
					[0, 1].map(() => (
						<div class="cine__marquee-set">
							{marquee.map((item) => (
								<>
									<span>{item}</span>
									<span class="cine__star">✦</span>
								</>
							))}
						</div>
					))
				}
			</div>
		</div>

		<div class="cine__center">
			<h2 class="cine__title" data-reveal>
				Ready to build<br /><span class="it">something quiet?</span>
			</h2>

			<div class="cine__links" data-reveal style="--i:1">
				<div class="cine__row">
					<a class="cine-pill cine-pill--lg cine-pill--accent" href={href('#contact')} data-magnetic>
						Start a project
						<Icon name="arrow-right" />
					</a>
					<a class="cine-pill cine-pill--lg" href={`mailto:${studio.email}`} data-magnetic>
						{studio.email}
					</a>
				</div>
				<nav class="cine__row cine__row--sm" aria-label="Footer">
					{
						sitemap.map((item) => (
							<a class="cine-pill" href={href(item.href)} data-magnetic>
								{item.label}
							</a>
						))
					}
				</nav>
			</div>
		</div>

		<div class="cine__bar">
			<p class="cine__copy" data-reveal style="--i:2">© {year} {studio.name} Arquitetura, Lda.</p>

			<div class="cine-pill cine__badge" data-reveal style="--i:2">
				<span class="cine__pulse" aria-hidden="true"></span>
				<span>{studio.address.slice(0, 2).join(', ')}</span>
				<span class="cine__sep" aria-hidden="true"></span>
				<a href={`tel:${studio.phone.replace(/\s/g, '')}`}>{studio.phone}</a>
			</div>

			<div class="cine__end" data-reveal style="--i:3">
				{
					studio.socials.map((s) => (
						<a
							class="cine-pill cine-pill--icon"
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${studio.name} on ${s.label}`}
							data-magnetic
						>
							<Icon name={socialIcon(s.label)} />
						</a>
					))
				}
				<a
					class="cine-pill cine-pill--icon cine__top"
					href={isHome ? '#top' : '/'}
					aria-label="Back to top"
					data-to-top-link
					data-magnetic
				>
					<Icon name="arrow-up" />
				</a>
			</div>
		</div>
	</footer>
</div>
