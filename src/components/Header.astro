---
import Icon from './Icon.astro';
import { nav, studio } from '../data/site';

// On sub-pages (e.g. 404) the section anchors live on the home page.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const href = (h: string) => (isHome ? h : `/${h}`);
const desktopNav = nav.filter((n) => n.href !== '#contact');
---

<header
	class:list={['site-header', { 'is-solid': !isHome }]}
	data-header
	data-static-solid={!isHome ? '' : undefined}
>
	<div class="site-header__bar">
		<a class="wordmark" href={isHome ? '#top' : '/'} aria-label={`${studio.name}, back to top`} style="--i:0">
			<span class="wordmark__mark" aria-hidden="true"></span>Minor Mass
		</a>

		<nav class="pill-nav" aria-label="Primary" style="--i:1" data-pill-nav>
			<span class="pill-nav__indicator" aria-hidden="true" data-pill-indicator></span>
			<ul class="pill-nav__list">
				{
					desktopNav.map((item) => (
						<li>
							<a class="pill-nav__link" href={href(item.href)} data-nav-link>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a class="header-cta" href={href('#contact')} style="--i:2">
			Get in touch
			<span class="header-cta__dot"><Icon name="arrow-right" /></span>
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-menu"
			data-menu-toggle
			style="--i:2"
		>
			<span data-menu-label>Menu</span>
			<span class="menu-toggle__bars" aria-hidden="true"></span>
		</button>
	</div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-label="Site menu" data-mobile-menu>
	<nav aria-label="Mobile">
		<ul class="mobile-menu__list">
			{
				nav.map((item, i) => (
					<li style={`--i:${i}`}>
						<a href={href(item.href)}>
							{item.label}
							<span>{String(i + 1).padStart(2, '0')}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="mobile-menu__foot">
		<a href={`mailto:${studio.email}`}>{studio.email}</a>
		<a href={`tel:${studio.phone.replace(/\s/g, '')}`}>{studio.phone}</a>
		<span>{studio.address.join(', ')}</span>
	</div>
</div>
