---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { studio } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${studio.name} | ${studio.tagline} studio, Lisbon`,
	description = studio.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0c0c0c" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			// `.js` enables the hidden "before" states of entrance animations.
			// Fail-safe: if the motion script has not started within 2.5s (blocked, failed
			// to load, very old browser), drop `.js` so every element shows in its final state.
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				setTimeout(function () {
					if (!root.classList.contains('motion-ready')) root.classList.remove('js');
				}, 2500);
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<BackToTop />
		<script>
			import '../scripts/main';
		</script>
	</body>
</html>
